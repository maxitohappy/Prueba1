# Copia este archivo como .env (que NUNCA se sube a git) y cambia los valores.
# Genera una clave con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
# Contraseña inicial del usuario 'admin' en modo seguro (mín. 12 caracteres, letras y números).
# Si no la defines, se genera una aleatoria y aparece en: docker compose logs app-secure
ADMIN_PASSWORD=
# Pon 1 solo si sirves la app por HTTPS
SESSION_COOKIE_SECURE=0
